generator client {
  provider      = "prisma-client-js"
  // GitHub Actions builds on debian; Vercel serverless runs rhel-openssl-3.0.x.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StoreCategory {
  JEWELRY
  HANDBAGS
  WATCHES
  OTHER
}

model Store {
  id             String        @id @default(cuid())
  name           String
  category       StoreCategory @default(JEWELRY)
  customCategory String?
  city           String
  state          String
  pincode             String?
  businessOwnerName   String?
  businessOwnerEmail  String?
  isActive            Boolean       @default(true)
  dataExpiryAt        DateTime?
  renewalDueAt        DateTime?
  deletedAt      DateTime?
  purgeAt        DateTime?
  deletedByEmail String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  appUsers   AppUser[]
  staff      Staff[]
  visits     Visit[]
  customers  Customer[]
  fieldSales FieldSale[]
  importHistory ImportHistory[]
  correctionRequests CorrectionRequest[]

  @@index([dataExpiryAt])
  @@index([renewalDueAt])
}

model StoreCategoryOption {
  id                String   @id @default(cuid())
  /// Canonical key — enum value for built-ins, custom name for store customCategory.
  name              String   @unique
  label             String
  isBuiltin         Boolean  @default(false)
  hiddenFromPicker  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Staff {
  id           String    @id @default(cuid())
  name         String
  employeeId   String    @unique
  phone        String?
  role         StaffRole @default(STAFF)
  isActive     Boolean   @default(true)
  storeId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  appUser           AppUser?
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  visits            Visit[]
  callLogs          StaffCallLog[]
  fieldSales        FieldSale[]
  assignedFollowUps FollowUp[]
  phoneRevealLogs   PhoneRevealLog[]
  correctionRequests CorrectionRequest[]

  @@index([storeId, isActive])
}

enum StaffRole {
  STAFF
  STORE_MANAGER
  MASTER_ADMIN
}

enum AppRole {
  MASTER_ADMIN
  PLATFORM_ADMIN
  BUSINESS_OWNER
  STORE_MANAGER
  STAFF
}

model AppUser {
  id           String    @id @default(cuid())
  authId       String?   @unique
  email        String    @unique
  name         String
  phone        String?
  passwordHash String?
  role         AppRole
  storeId      String?
  staffId      String?   @unique
  /// Portal feature flags for PLATFORM_ADMIN users (null for other roles).
  adminPermissions Json?
  isActive     Boolean   @default(false)
  invitedAt    DateTime?
  activatedAt  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store              Store?               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  staff              Staff?               @relation(fields: [staffId], references: [id], onDelete: SetNull)
  sessions           UserSession[]
  passwordResetTokens PasswordResetToken[]
  inviteTokens       InviteToken[]
  analyticsCredits   AnalyticsCreditAccount?

  @@index([storeId, role, isActive])
  @@index([email])
}

model UserSession {
  id        String   @id @default(cuid())
  appUserId String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  appUserId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, createdAt(sort: Desc)])
}

model InviteToken {
  id        String    @id @default(cuid())
  appUserId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  appUser AppUser @relation(fields: [appUserId], references: [id], onDelete: Cascade)

  @@index([appUserId, createdAt(sort: Desc)])
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  authId    String?
  email     String?
  event     String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([email, createdAt(sort: Desc)])
  @@index([event, createdAt(sort: Desc)])
}

model Customer {
  id           String   @id @default(cuid())
  phone        String
  phoneHash    String
  name         String
  nameSearch   String   @default("")
  phoneLast4   String?
  area         String?
  address      String?
  profession   String?
  gender       String?
  ageGroup     String?
  dateOfBirth  DateTime?
  anniversary  DateTime?
  activeScheme String?
  ghsEnrolled  Boolean  @default(false)
  storeId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  visits     Visit[]
  fieldSales FieldSale[]

  @@unique([phoneHash, storeId])
  @@index([storeId, updatedAt(sort: Desc)])
  @@index([storeId, nameSearch])
  @@index([storeId, phoneLast4])
}

model Visit {
  id                String                   @id @default(cuid())
  visitDate         DateTime                 @default(now())
  inTime            DateTime?
  outTime           DateTime?
  durationMins      Int?
  storeId           String
  staffId           String
  customerId        String?
  customerName        String
  customerPhone       String
  customerPhoneHash   String
  customerNameSearch  String   @default("")
  phoneLast4          String?
  customerType        CustomerType
  visitType         VisitType
  area              String?
  address           String?
  profession        String?
  gender            String?
  ageGroup          String?
  dateOfBirth       DateTime?
  anniversary       DateTime?
  purchaseStatus    PurchaseStatus
  productsPurchased String[]
  productsExplored  String[]
  transactionAmount Float?
  intentTier        IntentTier?
  reasonNoPurchase  String?
  competitorMention String?
  purchaseOccasion  String?
  metalKtPref       String?
  budgetStated      BudgetRange?
  schemeEnrolled    Boolean                  @default(false)
  ghsPolicy         Boolean                  @default(false)
  schemesPitched    SchemeProduct[]          @default([])
  enrollmentOutcome SchemeEnrollmentOutcome?
  monthlyCommitment Float?
  reasonNoEnrollment FieldDeclineReason?
  schemeCompetitorMention String?
  followUpNeeded    Boolean                  @default(false)
  followUpDate      DateTime?
  staffNotes        String?
  sourceChannel     SourceChannel
  lastCallAnswered  CallAnswerStatus?
  lastCallAt        DateTime?
  callValueTier     CallValueTier?
  birthMonth        Int?
  anniversaryMonth  Int?
  importBatchId     String?
  importedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  store           Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  followUp        FollowUp?
  callLogs        StaffCallLog[]
  phoneRevealLogs PhoneRevealLog[]
  correctionRequests CorrectionRequest[]

  @@index([storeId, visitDate(sort: Desc)])
  @@index([staffId, storeId, visitDate(sort: Desc)])
  @@index([staffId, storeId, visitDate(sort: Desc), lastCallAnswered])
  @@index([staffId, storeId, visitDate(sort: Desc), callValueTier, birthMonth, anniversaryMonth])
  @@index([storeId, customerPhoneHash])
  @@index([storeId, customerNameSearch])
  @@index([storeId, phoneLast4])
  @@index([importBatchId])
  // Analytics aggregate query support
  @@index([storeId, visitDate(sort: Desc), purchaseStatus])
  @@index([storeId, visitDate(sort: Desc), customerType, sourceChannel])
}

enum CustomerType {
  NEW
  REPEAT
  VIP
}

enum VisitType {
  WALK_IN
  APPOINTMENT
}

enum PurchaseStatus {
  PURCHASED
  NOT_PURCHASED
  PENDING
}

enum IntentTier {
  HOT
  WARM
  COLD
  BROWSING
}

enum BudgetRange {
  UNDER_15K
  K15_50K
  K50_1L
  ABOVE_1L
  NOT_STATED
}

enum SourceChannel {
  ORGANIC_WALK_IN
  REFERRAL
  SOCIAL_MEDIA
  INTERNET
  PHONE
  TANISHQ_REF
  CARATLANE_REF
  USER_CALLS
  OTHER
}

model FollowUp {
  id              String         @id @default(cuid())
  visitId         String?        @unique
  fieldSaleId     String?        @unique
  assignedStaffId String
  followUpDate    DateTime
  reason          String?
  context         String?
  callOutcome     String?
  outcomeDate     DateTime?
  status          FollowUpStatus @default(OPEN)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  visit         Visit?     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  fieldSale     FieldSale? @relation(fields: [fieldSaleId], references: [id], onDelete: Cascade)
  assignedStaff Staff      @relation(fields: [assignedStaffId], references: [id], onDelete: Restrict)

  @@index([assignedStaffId, status, followUpDate])
}

enum FollowUpStatus {
  OPEN
  CLOSED
  CONVERTED
  NO_RESPONSE
}

enum CallAnswerStatus {
  ANSWERED
  NOT_ANSWERED
}

enum CallValueTier {
  HIGH
  MID
  LOW
}

model StaffCallLog {
  id            String           @id @default(cuid())
  visitId       String?
  fieldSaleId   String?
  staffId       String
  answered      CallAnswerStatus
  feedback      String?
  importBatchId String?
  importedAt    DateTime?
  createdAt     DateTime         @default(now())

  visit     Visit?     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  fieldSale FieldSale? @relation(fields: [fieldSaleId], references: [id], onDelete: Cascade)
  staff     Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([visitId, staffId, createdAt(sort: Desc)])
  @@index([fieldSaleId, staffId, createdAt(sort: Desc)])
  @@index([staffId, createdAt(sort: Desc)])
  @@index([importBatchId])
}

model PhoneRevealLog {
  id          String   @id @default(cuid())
  visitId     String?
  fieldSaleId String?
  staffId     String
  createdAt   DateTime @default(now())

  visit     Visit?     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  fieldSale FieldSale? @relation(fields: [fieldSaleId], references: [id], onDelete: Cascade)
  staff     Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([visitId, staffId, createdAt(sort: Desc)])
  @@index([fieldSaleId, staffId, createdAt(sort: Desc)])
}

enum FieldActivityType {
  DOOR_TO_DOOR
  HOUSING_SOCIETY
  CORPORATE
  EVENT_EXHIBITION
  MARKET_STALL
  REFERRAL_MEET
  OTHER
}

enum SchemeProduct {
  GHS
  GPP
  NONE
}

enum SchemeEnrollmentOutcome {
  ENROLLED_GHS
  ENROLLED_GPP
  ENROLLED_BOTH
  INTERESTED
  DECLINED
  CALLBACK
}

enum FieldDeclineReason {
  BUDGET
  ALREADY_ENROLLED
  NOT_INTERESTED
  NEEDS_TIME
  TRUST_CONCERNS
  COMPETITOR_SCHEME
}

model FieldSale {
  id                  String                  @id @default(cuid())
  activityDate        DateTime                @default(now())
  startTime           DateTime?
  endTime             DateTime?
  durationMins        Int?
  storeId             String
  staffId             String
  customerId          String?
  customerName        String
  customerPhone       String
  customerPhoneHash   String?
  customerNameSearch  String   @default("")
  phoneLast4          String?
  customerType        CustomerType
  area                String?
  gender              String?
  ageGroup            String?
  profession          String?
  activityType        FieldActivityType
  locationLabel       String?
  schemesPitched      SchemeProduct[]          @default([])
  enrollmentOutcome   SchemeEnrollmentOutcome?
  monthlyCommitment   Float?
  intentTier          IntentTier?
  reasonNoEnrollment  FieldDeclineReason?
  competitorMention   String?
  followUpNeeded      Boolean                 @default(false)
  followUpDate        DateTime?
  staffNotes          String?
  lastCallAnswered    CallAnswerStatus?
  lastCallAt          DateTime?
  callValueTier       CallValueTier?
  birthMonth          Int?
  anniversaryMonth    Int?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  staff    Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  followUp FollowUp?
  callLogs StaffCallLog[]
  phoneRevealLogs PhoneRevealLog[]
  correctionRequests CorrectionRequest[]

  @@index([staffId, activityDate(sort: Desc)])
  @@index([staffId, storeId, activityDate(sort: Desc), lastCallAnswered])
  @@index([staffId, storeId, activityDate(sort: Desc), callValueTier, birthMonth, anniversaryMonth])
  @@index([storeId, activityDate(sort: Desc)])
}

model ImportHistory {
  id                       String   @id @default(cuid())
  batchId                  String   @unique
  featureKey               String
  fileName                 String?
  storeId                  String
  totalRows                Int
  successCount             Int
  errorCount               Int
  newCustomers             Int
  repeatCustomers          Int
  importedByAuthId         String
  importedAt               DateTime @default(now())
  rollbackAvailableUntil   DateTime
  rolledBackAt             DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([featureKey])
  @@index([storeId, importedAt(sort: Desc)])
  @@index([importedByAuthId])
}

enum CorrectionRequestStatus {
  OPEN
  RESOLVED
}

model CorrectionRequest {
  id          String                  @id @default(cuid())
  storeId     String
  staffId     String
  visitId     String?
  fieldSaleId String?
  message     String                  @db.VarChar(500)
  status      CorrectionRequestStatus @default(OPEN)
  createdAt   DateTime                @default(now())
  resolvedAt  DateTime?

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  staff     Staff      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  visit     Visit?     @relation(fields: [visitId], references: [id], onDelete: SetNull)
  fieldSale FieldSale? @relation(fields: [fieldSaleId], references: [id], onDelete: SetNull)

  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([staffId, createdAt(sort: Desc)])
}

enum BillingPaymentStatus {
  UNPAID
  PAID
  PARTIAL
  WAIVED
  DISPUTED
}

enum BillingFollowUpChannel {
  EMAIL
  PHONE
  WHATSAPP
  IN_PERSON
  OTHER
}

enum BillingFollowUpOutcome {
  NO_RESPONSE
  PROMISED_PAYMENT
  PARTIAL_PAYMENT
  PAID
  DISPUTED
  RESCHEDULED
  OTHER
}

model BillingBusinessAccount {
  id                String               @id @default(cuid())
  businessKey       String               @unique
  businessName      String
  businessEmail     String?
  paymentStatus     BillingPaymentStatus @default(UNPAID)
  lastInvoiceNumber String?
  lastInvoiceSentAt DateTime?
  lastFollowUpAt    DateTime?
  nextFollowUpAt    DateTime?
  paidAt            DateTime?
  billingAnchorAt   DateTime?
  /** Consolidated payment clears all periods through this activation period end. */
  paidThroughPeriodEnd DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  followUps   BillingFollowUp[]
  invoiceLogs BillingInvoiceLog[]

  @@index([paymentStatus])
  @@index([nextFollowUpAt])
}

model BillingInvoiceLog {
  id                String   @id @default(cuid())
  accountId         String
  invoiceNumber     String
  sentTo            String
  grandTotal        Int
  sentByEmail       String?
  periodStart       DateTime?
  periodEnd         DateTime?
  unpaidPeriodCount Int?
  periodBreakdown   Json?
  createdAt         DateTime @default(now())

  account BillingBusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
}

model BillingFollowUp {
  id             String                 @id @default(cuid())
  accountId      String
  channel        BillingFollowUpChannel
  outcome        BillingFollowUpOutcome @default(RESCHEDULED)
  notes          String                 @db.VarChar(2000)
  nextFollowUpAt DateTime?
  createdByEmail String?
  createdByName  String?
  createdAt      DateTime               @default(now())

  account BillingBusinessAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
}

enum AnalyticsCreditLedgerType {
  GRANT
  RECHARGE
  USAGE
}

model AnalyticsCreditAccount {
  id             String   @id @default(cuid())
  appUserId      String   @unique
  balanceCredits Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appUser AppUser                  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  ledger  AnalyticsCreditLedger[]

  @@index([appUserId])
}

model AnalyticsCreditLedger {
  id                String                    @id @default(cuid())
  accountId         String
  type              AnalyticsCreditLedgerType
  amount            Int
  packId            String?
  tokensUsed        Int?
  description       String?
  externalPaymentId String?                   @unique
  createdAt         DateTime                  @default(now())

  account AnalyticsCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt(sort: Desc)])
}

model AnalyticsAskLog {
  id               String   @id @default(cuid())
  appUserId        String
  promptLength     Int
  parseSource      String
  parseConfidence  String
  dataAvailability String
  status           String
  errorCode        String?
  durationMs       Int
  intentTokensIn   Int?
  intentTokensOut  Int?
  reportTokensIn   Int?
  reportTokensOut  Int?
  totalCostUsd     Float?
  createdAt        DateTime @default(now())

  @@index([appUserId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

/// Singleton platform-wide billing automation configuration (id = "platform").
model PlatformAutomationConfig {
  id             String   @id @default("platform")
  config         Json
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

/// Singleton platform-wide master settings (id = "platform").
model PlatformSettings {
  id             String   @id @default("platform")
  config         Json
  updatedAt      DateTime @updatedAt
  updatedByEmail String?
}

enum AutomationRunTrigger {
  CRON
  MANUAL
  DRY_RUN
}

enum AutomationRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model AutomationRunLog {
  id               String               @id @default(cuid())
  trigger          AutomationRunTrigger
  status           AutomationRunStatus
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  summary          Json
  errors           Json?
  triggeredByEmail String?

  @@index([startedAt(sort: Desc)])
}

/// Idempotency ledger — prevents duplicate automated sends within a billing cycle.
model AutomationDeliveryLog {
  id          String   @id @default(cuid())
  businessKey String?
  actionType  String
  dedupeKey   String   @unique
  channel     String?
  status      String
  message     String?
  createdAt   DateTime @default(now())

  @@index([businessKey, actionType, createdAt(sort: Desc)])
}
