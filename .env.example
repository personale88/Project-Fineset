# PostgreSQL — local dev or direct connection to your DB server (:5432)
# Password with @ must be URL-encoded as %40
DATABASE_URL="postgresql://postgres:password@localhost:5432/fineset"
# Required for prisma migrate on Supabase/Railway when DATABASE_URL uses the :6543 pooler.
# Use the direct/session connection (:5432). If omitted or set to :6543, prisma.config.ts normalizes it automatically.
DIRECT_URL="postgresql://postgres:password@localhost:5432/fineset"

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP — required in production for invites and password reset
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="FineSet <noreply@example.com>"
# SMTP_SECURE="false"
# SMTP_REQUIRE_TLS="true"

# PII encryption — keep the same key if you reuse an existing database (64-char hex)
ENCRYPTION_KEY="jyyfyfyjfjyfyjfdtdkkloufyidtdrsyrtgchjvkjvlkycjtgxfgmckckjxjgfckhckjgtcxfx"

# Upstash Redis — required in production for rate limiting AND analytics caching.
# Without these, every analytics ask hits the DB with no cache (still works, just slower).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Bootstrap admin (used by npm run auth:bootstrap)
MASTER_ADMIN_EMAIL="admin@fineset.local"
MASTER_ADMIN_PASSWORD="change-me"
MASTER_ADMIN_NAME="Admin"

# E2E tests (optional)
# E2E_USER_EMAIL=""
# E2E_USER_PASSWORD=""

# Local-only — skip password check at sign-in (never set in production)
# DEV_AUTH_BYPASS="true"

# Google Gemini — optional; enables AI intent parsing in Analytics (reports use DB metrics only)
# GEMINI_API_KEY="your-key-from-aistudio.google.com"

# Admin platform (optional)
# PAYMENT_PROVIDER=none|noop|razorpay|stripe  — none in production disables credit recharge
# ALLOW_ADMIN_IMPERSONATION=true  — enable store impersonation in production (default: dev only)
# CRON_SECRET="generate-with-openssl-rand-base64-32"  — secures /api/cron/billing-automation
# ENABLE_RATE_LIMIT="true"  # optional in dev; analytics ask limited to 30 req / 15 min per user+IP
