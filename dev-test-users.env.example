# Local test login accounts (local auth + Prisma AppUser)
#
# Setup:
#   1. Copy .env.example → .env.local and fill DATABASE_URL, AUTH_SECRET, ENCRYPTION_KEY
#   2. npm run db:migrate
#   3. npm run db:seed
#   4. npm run auth:bootstrap-dev
#   5. Optional: DEV_AUTH_BYPASS="true" in .env.local to sign in with email only
#
# Sign in at http://localhost:3000

DEV_LOGIN_PASSWORD=FineSet#1dev

# Playwright / E2E (optional — use after auth:bootstrap for admin)
E2E_USER_EMAIL=admin@fineset.local
E2E_USER_PASSWORD=FineSet#1dev

# Accounts created by auth:bootstrap-dev (password FineSet#1dev)
# admin@fineset.local          MASTER_ADMIN
# manager@store-alpha.local    BUSINESS_OWNER (Store Alpha)
# store-manager@store-alpha.local  STORE_MANAGER
# staff-a@store-alpha.local    STAFF          (Store Alpha, EMP001)
# owner@royal-time.local       BUSINESS_OWNER (Royal Watches — billing overdue demo)
# bags@luxebags.local          BUSINESS_OWNER
# preeti@handbags-boutique.local  BUSINESS_OWNER
# heritage@kochi.local         BUSINESS_OWNER
# mixed@jewels.local           BUSINESS_OWNER

# Multi-store business owner dashboard (4 stores + notifications data):
#   npm run db:seed:business-owner
#
# Multi-store dropdown testing (links 4 stores to manager email):
#   npm run db:seed:store-selector
#
# Staff calls page mock data (retention / not-answered / follow-up / external queues):
#   npm run db:seed:staff-calls
